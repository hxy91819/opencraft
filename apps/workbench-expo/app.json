{
  "expo": {
    "name": "OpenCraft",
    "slug": "opencraft-workbench",
    "version": "0.1.0",
    "scheme": "opencraft",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vela.workbench"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
