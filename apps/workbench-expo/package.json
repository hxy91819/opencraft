{
  "name": "@opencraft/workbench-expo",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/run-expo.cjs start",
    "android": "node scripts/run-expo.cjs run:android",
    "ios": "node scripts/run-expo.cjs run:ios",
    "prebuild:ios": "node scripts/run-expo.cjs prebuild --platform ios",
    "bundle:ios": "node scripts/run-expo.cjs export:embed --platform ios --dev false --entry-file index.ts --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios/assets",
    "web": "node scripts/run-expo.cjs start --web",
    "export:web": "node scripts/run-expo.cjs export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@expo/metro-runtime": "^57.0.14",
    "@tanstack/react-query": "^5.102.8",
    "@opencraft/appserver-protocol": "0.1.0",
    "@opencraft/appserver-replica-storage-expo": "0.1.0",
    "@opencraft/appserver-replica-storage-web": "0.1.0",
    "@opencraft/appserver-transport-websocket": "0.1.0",
    "@opencraft/chat-core": "0.1.0",
    "@opencraft/chat-render-native": "0.1.0",
    "@opencraft/chat-render-react": "0.1.0",
    "@opencraft/composer-core": "0.1.0",
    "@opencraft/design-system": "0.1.0",
    "@opencraft/react-runtime": "0.1.0",
    "@opencraft/timeline-react": "0.1.0",
    "@opencraft/timeline-render-react": "0.1.0",
    "@opencraft/timeline-virtualizer": "0.1.0",
    "@opencraft/workbench-runtime": "0.1.0",
    "expo": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "1.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
